---
import Service from "../cards/Service.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { services } from "../../utils/data.ts";

type ServicesProps = {
  title: string;
  features: string[];
  icon: string;
};

export interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<section
  id="services"
  class=`relative bg-gradient-to-br from-wood-cream to-wood-light dark:from-wood-dark dark:to-accent-green ${className}`
>
  <span
    class="w-40 h-40 rounded-full bg-gradient-to-br from-wood-light dark:from-wood-light from-0% via-wood-dark dark:via-wood-dark via-80% to-accent-green dark:to-accent-green to-110%
    absolute left-1/3 bottom-1/3"
  ></span>
  <span
    class="w-40 h-40 rounded-full bg-gradient-to-br from-wood-cream dark:from-wood-light from-0% via-wood-light dark:via-wood-dark via-85% to-wood-dark dark:to-wood-dark to-100%
    absolute right-1/4 bottom-0"
  ></span>
  <span
    class="w-40 h-40 rounded-full bg-gradient-to-br from-accent-terra dark:from-accent-terra from-0% via-wood-dark dark:via-wood-dark via-80% to-wood-light dark:to-wood-light to-110%
    absolute right-1/3 top-1/3"
  ></span>

  <span
    class="w-40 h-40 rounded-full bg-gradient-to-br from-accent-terra dark:from-accent-terra from-0% via-wood-dark dark:via-wood-dark via-80% to-wood-light dark:to-wood-light to-110%
    absolute right-3/4 top-1/3"
  ></span>
  <Container className="space-y-10 md:sapce-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <Title className="">Why Choose Sindiyan?</Title>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        services.map((service: ServicesProps) => {
          return (
            <Service
              title={service.title}
              features={service.features}
              icon={service.icon}
            />
          );
        })
      }
    </div>
  </Container>
</section>