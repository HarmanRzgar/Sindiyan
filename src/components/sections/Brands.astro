---
import { Image } from "astro:assets";
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";

// Use dynamic imports
const kronospan = await import("@assets/logos/Kronospan.png");
const camsan = await import("@assets/logos/camsan.png");
const starwood = await import("@assets/logos/starwood.png");
const kastamonu = await import("@assets/logos/kastamonu.png");
const yildiz = await import("@assets/logos/yildiz.png");

const brands = [
  {
    id: 1,
    name: "Yildiz Entegre",
    logo: yildiz.default,
  },
  {
    id: 2,
    name: "Camsan Ordu",
    logo: camsan.default,
  },
  {
    id: 3,
    name: "Kronospan",
    logo: kronospan.default,
  },
  {
    id: 4,
    name: "Kastamonu",
    logo: kastamonu.default,
  },
  {
    id: 5,
    name: "Starwood",
    logo: starwood.default,
  },
];

const { className } = Astro.props;
---

<section class=`${className}`>
  <Container className="space-y-8">
    <div class="text-center max-w-3xl mx-auto">
      <Title>Our partners in the industry</Title>
    </div>
    <div class="flex justify-center flex-wrap gap-4">
      {
        brands.map((brand) => (
          <div class="p-4 sm:p-5 rounded-xl border border-box-border group bg-box-bg">
            <Image
              src={brand.logo}
              width="100"
              height="60"
              alt={brand.name}
              class="h-7 sm:h-10 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105"
            />
          </div>
        ))
      }
    </div>
  </Container>
</section>